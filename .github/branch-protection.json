{
  "required_status_checks": {
    "strict": true,
    "contexts": [
      "fmt",
      "clippy",
      "supply chain",
      "test (ubuntu-latest, all-features)",
      "test (ubuntu-latest, no-default-features)",
      "test (macos-latest, all-features)",
      "test (macos-latest, no-default-features)",
      "test (windows-latest, all-features)",
      "test (windows-latest, no-default-features)"
    ]
  },
  "enforce_admins": false,
  "required_pull_request_reviews": {
    "dismissal_restrictions": {},
    "dismiss_stale_reviews": true,
    "require_code_owner_reviews": false,
    "required_approving_review_count": 1
  },
  "restrictions": null,
  "required_linear_history": false,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "required_conversation_resolution": true,
  "lock_branch": false,
  "allow_fork_syncing": true
}
