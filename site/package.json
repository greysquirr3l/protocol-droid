{
  "name": "protocol-droid-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Documentation site for protocol-droid, deployed to greysquirr3l.github.io",
  "scripts": {
    "dev": "npx astro dev",
    "start": "npx astro dev",
    "build": "npx astro build",
    "preview": "npx astro preview",
