    "subdir": "protocol-droid",
    "liveUrl": "https://greysquirr3l.github.io/protocol-droid/",
    "sourceRepo": "greysquirr3l/protocol-droid"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/starlight": "^0.30.0",
    "astro": "^5.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0"
  }
}
